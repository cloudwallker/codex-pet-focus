<Application x:Class="CodexPetFocus.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="FocusBrush" Color="#B8E5C8"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B2C1CF"/>
  <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource FocusBrush}" BorderThickness="2" CornerRadius="8" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Window"><Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#EEF4F8"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="15"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#283747"/><Setter Property="Foreground" Value="#EEF4F8"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border><Border x:Name="FocusRing" BorderBrush="{StaticResource FocusBrush}" BorderThickness="2" CornerRadius="10" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#B8E5C8"/><Setter Property="Foreground" Value="#14251D"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#192534"/><Setter Property="Foreground" Value="#EEF4F8"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#36495E"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="15"/><Setter Property="SelectionBrush" Value="#427C66"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D3DFE9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="MinHeight" Value="32"/></Style>
 </Application.Resources>
</Application>
